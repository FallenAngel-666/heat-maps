{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/standalone-3d-view.html",
      "destination": "/standalone-3d-view.html"
    },
    {
      "source": "/campuspulse-3d.html",
      "destination": "/campuspulse-3d.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
